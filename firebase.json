{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/config.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/vendor/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "/data/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      }
    ],
    "redirects": [
      { "source": "/sites/:sitename/index.html", "destination": "/sites/:sitename/", "type": 301 },
      { "source": "/sites/:sitename/index",      "destination": "/sites/:sitename/", "type": 301 }
    ],
    "rewrites": [
      { "source": "/test/space/master", "destination": "/test/space.html" },
      { "source": "/space2/master",     "destination": "/space2.html" },
      { "source": "/space3/master",     "destination": "/space3.html" },
      { "source": "/space2",            "destination": "/space2.html" },
      { "source": "/space2-snap",       "destination": "/space2-snap.html" },
      { "source": "/space3",            "destination": "/space3.html" },
      { "source": "/space2/youtube",    "destination": "/space2-youtube.html" }
    ]
  }
}
